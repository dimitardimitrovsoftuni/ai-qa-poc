# Copy to .env and fill in. Never commit .env.

# OpenRouter — free tier, no credit card needed for :free models.
# openrouter.ai -> sign in -> Keys -> Create Key
OPENROUTER_API_KEY=

# Public demo credentials for site #1 (published on the SauceDemo login page).
# Kept in env rather than in the site descriptor so the pattern stays honest
# for real products, where credentials must never be committed.
SAUCEDEMO_USER=standard_user
SAUCEDEMO_PASS=secret_sauce

# Python interpreter used to run the generated pytest suites.
PYTEST_PYTHON=python

# Public demo credentials for site #2 (seeded accounts, published in the
# practice-software-testing repo README).
TOOLSHOP_USER=customer@practicesoftwaretesting.com
TOOLSHOP_PASS=welcome01
