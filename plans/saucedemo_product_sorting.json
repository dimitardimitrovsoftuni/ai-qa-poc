      "id": "sort_by_price_high_to_low",
      "name": "test_sort_by_price_high_to_low",
      "title": "Sorting by price high to low updates active option and shows most expensive product first",
      "pages": [
        "inventory"
      ],
      "preconditions": [
        "logged in"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/inventory.html"
        },
        {
          "action": "select",
          "selector": "[data-test=\"product-sort-container\"]",
          "value": "hilo"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"active-option\"]",
          "value": "Price (high to low)"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"inventory-item-name\"]",
          "value": "Sauce Labs Fleece Jacket"
        }
      ],
      "expected": [
        "the active option label reads \"Price (high to low)\"",
        "the first product listed is the most expensive item (Sauce Labs Fleece Jacket)"
      ]
    },
