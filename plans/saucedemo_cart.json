  "tests": [
    {
      "id": "remove_item_from_cart",
      "name": "test_remove_item_from_cart",
      "title": "Removing an item empties the cart and hides the badge",
      "pages": [
        "inventory",
        "cart"
      ],
      "preconditions": [
        "logged in"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/inventory.html"
        },
        {
          "action": "click",
          "selector": "[data-test=\"add-to-cart-sauce-labs-backpack\"]"
        },
        {
          "action": "click",
          "selector": "[data-test=\"shopping-cart-link\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"cart-list\"]"
        },
        {
          "action": "click",
          "selector": "[data-test=\"remove-sauce-labs-backpack\"]"
        },
        {
          "action": "expect_absent",
          "selector": "[data-test=\"remove-sauce-labs-backpack\"]",
          "note": "item removed from cart"
        },
        {
          "action": "expect_absent",
          "selector": "[data-test=\"shopping-cart-badge\"]",
          "note": "badge disappears when cart is empty"
        },
        {
          "action": "click",
          "selector": "[data-test=\"continue-shopping\"]"
        },
        {
          "action": "expect_url",
          "value": "/inventory.html"
        }
      ],
      "expected": [
        "remove button disappears after clicking",
        "cart badge is no longer present in the header",
        "continue shopping returns to the inventory page"
      ]
    },
