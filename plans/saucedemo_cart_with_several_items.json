  "tests": [
    {
      "id": "cart_add_multiple_items_verify_and_remove_one",
      "name": "test_cart_add_multiple_items_verify_and_remove_one",
      "title": "Adding multiple items shows correct badge count and cart contents; removing one updates both",
      "pages": [
        "inventory",
        "cart_two_items"
      ],
      "preconditions": [
        "logged in",
        "empty cart"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/inventory.html"
        },
        {
          "action": "click",
          "selector": "[data-test=\"add-to-cart-sauce-labs-backpack\"]"
        },
        {
          "action": "click",
          "selector": "[data-test=\"add-to-cart-sauce-labs-bike-light\"]"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"shopping-cart-badge\"]",
          "value": "2"
        },
        {
          "action": "click",
          "selector": "[data-test=\"shopping-cart-link\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"remove-sauce-labs-backpack\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"remove-sauce-labs-bike-light\"]"
        },
        {
          "action": "click",
          "selector": "[data-test=\"remove-sauce-labs-backpack\"]"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"shopping-cart-badge\"]",
          "value": "1"
        },
        {
          "action": "expect_absent",
          "selector": "[data-test=\"remove-sauce-labs-backpack\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"remove-sauce-labs-bike-light\"]"
        }
      ],
      "expected": [
        "cart badge shows 2 after adding two items",
        "cart page lists both items with their remove buttons",
        "after removing one item badge updates to 1",
        "removed item's row disappears while the other remains"
      ]
    },
