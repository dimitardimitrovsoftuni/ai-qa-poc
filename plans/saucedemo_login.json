{
  "site": "saucedemo",
  "feature": "login",
  "tests": [
    {
      "id": "login_success_standard_user",
      "name": "test_login_success_standard_user",
      "title": "Standard user can log in and reaches the inventory page",
      "pages": [
        "login",
        "inventory"
      ],
      "preconditions": [
        "logged out"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"username\"]",
          "value": "standard_user"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"password\"]",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "selector": "[data-test=\"login-button\"]"
        },
        {
          "action": "expect_url",
          "value": "/inventory.html"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"title\"]",
          "note": "Products title visible on inventory page"
        }
      ],
      "expected": [
        "user is redirected to the inventory page",
        "the Products header is displayed"
      ]
    },
    {
      "id": "login_failure_locked_out_user",
      "name": "test_login_failure_locked_out_user",
      "title": "Locked out user sees an error and remains on the login page",
      "pages": [
        "login",
        "login_error"
      ],
      "preconditions": [
        "logged out"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"username\"]",
          "value": "locked_out_user"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"password\"]",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "selector": "[data-test=\"login-button\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"error\"]",
          "note": "error banner appears"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"error\"]",
          "value": "Epic sadface: Sorry, this user has been locked out."
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"login-button\"]",
          "note": "login form still present"
        }
      ],
      "expected": [
        "an error message stating the user is locked out is displayed",
        "the user is not signed in and the login form remains visible"
      ]
    },
