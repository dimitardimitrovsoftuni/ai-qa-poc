  "tests": [
    {
      "id": "search_returns_matching_products",
      "name": "test_search_returns_matching_products",
      "title": "Searching for a substring returns matching products with correct count",
      "pages": [
        "home",
        "search_results"
      ],
      "preconditions": [
        "logged out"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"search-query\"]",
          "value": "pliers"
        },
        {
          "action": "click",
          "selector": "[data-test=\"search-submit\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"search-caption\"]",
          "note": "search completed heading appears"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"search-term\"]",
          "value": "pliers"
        },
        {
          "action": "expect_text",
          "selector": "[data-test=\"search-result-count\"]",
          "value": "4 products found for 'pliers'"
        },
        {
          "action": "expect_count",
          "selector": "[data-test=\"product-name\"]",
          "value": 4
        }
      ],
      "expected": [
        "search results page shows the searched term",
        "result count matches the number of product cards displayed",
        "all returned product names contain the search substring"
      ]
    },
