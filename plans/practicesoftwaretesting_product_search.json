      "name": "test_search_reset_clears_results",
      "title": "Clicking the reset button clears the search and restores the full catalogue",
      "pages": [
        "home",
        "search_results"
      ],
      "preconditions": [
        "logged out"
      ],
      "steps": [
        {
          "action": "goto",
          "value": "/"
        },
        {
          "action": "fill",
          "selector": "[data-test=\"search-query\"]",
          "value": "pliers"
        },
        {
          "action": "click",
          "selector": "[data-test=\"search-submit\"]"
        },
        {
          "action": "expect_visible",
          "selector": "[data-test=\"search-caption\"]",
          "note": "search results shown"
        },
        {
          "action": "expect_count",
          "selector": "[data-test=\"product-name\"]",
          "value": 4
        },
        {
          "action": "click",
          "selector": "[data-test=\"search-reset\"]"
        },
        {
          "action": "expect_absent",
          "selector": "[data-test=\"search-caption\"]",
          "note": "search completed heading gone"
        },
        {
          "action": "expect_count",
          "selector": "[data-test=\"product-name\"]",
          "value": 9,
          "note": "full catalogue restored (9 products on first page)"
        }
      ],
      "expected": [
        "reset button clears the search input",
        "search results heading disappears",
        "full product catalogue is displayed again with more products than the filtered results"
      ]
